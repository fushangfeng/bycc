{
    "encoders": {
        "一维态势编码器1": {
            "type": "1D_encoder",
            "network": "dense",
            "params": {
                "hidden_layer_sizes": [
                    32
                ],
                "activation": "relu"
            },
            "input": [
                {
                    "name": "一维态势1"
                }
            ],
            "output": [
                {
                    "name": "一维态势1编码器输出"
                }
            ]
        }
    },
    "aggregators": {
        "聚合器1": {
            "type": "aggregator",
            "network": "gru",
            "params": {
                "hidden_layer": 64,
                "seq_len": 1,
                "activation": "relu"
            },
            "input": [
                {
                    "name": "一维态势1编码器输出"
                }
            ],
            "output": [
                {
                    "name": "聚合器1输出"
                },
                {
                    "name": "聚合器1输出2"
                }
            ]
        }
    },
    "decoders": {
        "单选动作解码器1": {
            "type": "value",
            "network": "value",
            "params": {
                "hidden_layer_sizes": [
                    1
                ],
                "activation": "relu"
            },
            "input": [
                {
                    "name": "聚合器1输出"
                }
            ],
            "output": [
                {
                    "name": "解码器1输出"
                }
            ]
        }
    }
}